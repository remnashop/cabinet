  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Refresh Expires At"
          }
        },
        "type": "object",
        "required": [
          "expires_at",
          "refresh_expires_at"
        ],
        "title": "AuthResponse"
      },
      "AuthType": {
        "type": "string",
        "enum": [
          "telegram",
          "email",
          "google",
          "yandex",
          "vk"
        ],
        "title": "AuthType"
      },
      "ChangeEmailRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "ChangeEmailRequest"
      },
      "ChangeEmailResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "pending_email": {
            "type": "string",
            "title": "Pending Email"
          }
        },
        "type": "object",
        "required": [
          "success",
          "pending_email"
        ],
        "title": "ChangeEmailResponse"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Current Password"
          },
          "new_password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 8,
            "title": "New Password"
          }
        },
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest"
      },
      "ChangePasswordResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "ChangePasswordResponse"
      },
      "ConfirmEmailVerificationRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^\\d{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "ConfirmEmailVerificationRequest"
      },
      "ConfirmEmailVerificationResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "success",
          "email"
        ],
        "title": "ConfirmEmailVerificationResponse"
      },
      "DeviceDeleteResponse": {
        "properties": {
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "deleted"
        ],
        "title": "DeviceDeleteResponse"
      },
      "DeviceResponse": {
        "properties": {
          "hwid": {
            "type": "string",
            "title": "Hwid"
          },
          "platform": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Platform"
          },
          "device_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Model"
          },
          "os_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Os Version"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "type": "object",
        "required": [
          "hwid"
        ],
        "title": "DeviceResponse"
      },
      "DevicesDeleteAllResponse": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "DevicesDeleteAllResponse"
      },
      "DevicesResponse": {
        "properties": {
          "devices": {
            "items": {
              "$ref": "#/components/schemas/DeviceResponse"
            },
            "type": "array",
            "title": "Devices"
          },
          "current_count": {
            "type": "integer",
            "title": "Current Count"
          },
          "max_count": {
            "type": "integer",
            "title": "Max Count"
          }
        },
        "type": "object",
        "required": [
          "devices",
          "current_count",
          "max_count"
        ],
        "title": "DevicesResponse"
      },
      "DurationGatewayPriceResponse": {
        "properties": {
          "gateway_type": {
            "$ref": "#/components/schemas/PaymentGatewayType"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
