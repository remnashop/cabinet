# Template for configuring the Remnashop web cabinet
# Instructions: https://remnashop.dev/docs/getting-started/web-cabinet/


# Address of the Remnashop API
# Same server: the Remnashop container on the Docker network, keep the default
# Separate server: https://SHOP_DOMAIN, the value of APP_DOMAIN, WITHOUT a trailing slash
# Plain http:// is accepted only for a container name on the Docker network
API_URL=http://remnashop:5000

# Proves to Remnashop that requests come through this cabinet
# Same value as CABINET_PROXY_SECRET in the Remnashop .env (set CABINET_DOMAIN there too)
# Generate: openssl rand -hex 32 (letters, digits, _ and - only)
# !!! Never share it
CABINET_PROXY_SECRET=change_me
